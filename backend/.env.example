# 后端服务
KST_HTTP_ADDR=0.0.0.0:8080
RUST_LOG=kst_server=info,tower_http=info

# PostgreSQL（与 deploy/.env 中的端口保持一致）
DATABASE_URL=postgres://kst:kst_dev_password@127.0.0.1:15432/kst

# JWT（至少 32 个字符）
KST_JWT_SECRET=kst_dev_jwt_secret_change_me_0123456789
KST_JWT_TTL_HOURS=12

# 首次启动时若无任何用户，用该账号创建初始管理员
KST_ADMIN_USERNAME=admin
KST_ADMIN_PASSWORD=admin123

# 任务结果保留与缓存（小时/分钟）
KST_JOB_RETENTION_HOURS=168
KST_JOB_CLEANUP_INTERVAL_MINUTES=60
KST_JOB_CACHE_HOURS=24

# AI 能力（可选，留空即关闭；也可用 KST_AI_ENABLED=false 显式关闭）
KST_AI_ENABLED=false
KST_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
KST_AI_API_KEY=
KST_AI_MODEL=
KST_AI_TIMEOUT_SECONDS=60

# Space-Track TLE 导入（可选）
KST_SPACETRACK_USERNAME=
KST_SPACETRACK_PASSWORD=
